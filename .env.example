# Client Credentials (lectura: playlist + búsqueda) — de tu app en developer.spotify.com
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_PLAYLIST_ID=

# Se obtiene una única vez visitando /api/auth/spotify/login como dueño del sitio
# (habilita escritura: agregar canciones recomendadas al playlist)
SPOTIFY_REFRESH_TOKEN=

# Redis (Upstash vía Vercel Marketplace) — se completan solas si usás la integración,
# o las copiás manualmente desde el dashboard de Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
