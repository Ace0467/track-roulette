# Client Credentials (solo búsqueda) — de tu app en developer.spotify.com
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_PLAYLIST_ID=

# Debe coincidir EXACTO con una Redirect URI registrada en tu app de Spotify.
# Local: http://127.0.0.1:3000/api/auth/spotify/callback (Spotify ya no acepta "localhost")
# Producción: https://tu-dominio.vercel.app/api/auth/spotify/callback
SPOTIFY_REDIRECT_URI=

# Se obtiene una única vez visitando /api/auth/spotify/login como dueño del sitio.
# Requerido tanto para LEER el playlist (Spotify ya no permite leerlo con Client
# Credentials) como para escribir canciones recomendadas.
SPOTIFY_REFRESH_TOKEN=

# Redis (Upstash vía Vercel Marketplace) — se completan solas si usás la integración,
# o las copiás manualmente desde el dashboard de Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
